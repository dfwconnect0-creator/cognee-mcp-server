# Cognee Local Configuration — 100% Offline with Ollama
# Copy to .env and fill in your values

# ===================== LLM =====================
LLM_PROVIDER="ollama"
LLM_MODEL="qwen2.5:7b"
LLM_ENDPOINT="http://localhost:11434/v1"
LLM_API_KEY="ollama"

# ===================== Embeddings =====================
EMBEDDING_PROVIDER="ollama"
EMBEDDING_MODEL="nomic-embed-text:latest"
EMBEDDING_ENDPOINT="http://localhost:11434/api/embed"
EMBEDDING_DIMENSIONS="768"
HUGGINGFACE_TOKENIZER="nomic-ai/nomic-embed-text-v1.5"

# ===================== Graph Database =====================
GRAPH_DATABASE_PROVIDER="neo4j"
GRAPH_DATABASE_URL="bolt://localhost:7687"
GRAPH_DATABASE_USERNAME="neo4j"
GRAPH_DATABASE_PASSWORD="CHANGE_ME"

# Fix: Set handler to match neo4j provider (default is 'kuzu' which conflicts)
GRAPH_DATASET_DATABASE_HANDLER="neo4j_aura_dev"

# Fix: Disable multi-user mode (single-user local setup, avoids handler conflict)
ENABLE_BACKEND_ACCESS_CONTROL="false"

# ===================== Vector Store =====================
VECTOR_DB_PROVIDER="lancedb"

# ===================== Relational DB =====================
DB_PROVIDER="sqlite"
